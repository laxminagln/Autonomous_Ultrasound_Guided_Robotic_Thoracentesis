<launch>
  <arg name="robot_ip" default="172.16.0.2"/>
  <arg name="load_gripper" default="false"/>

  <!-- Franka control -->
  <include file="$(find franka_control)/launch/franka_control.launch">
    <arg name="robot_ip" value="$(arg robot_ip)"/>
    <arg name="load_gripper" value="$(arg load_gripper)"/>
  </include>

  <!-- Spawn the arm trajectory controller that MoveIt expects -->
  <node name="arm_controller_spawner"
        pkg="controller_manager"
        type="spawner"
        respawn="false"
        output="screen"
        args="position_joint_trajectory_controller" />

  <node pkg="tf2_ros"
      type="static_transform_publisher"
      name="world_to_panda_link0"
      args="0 0 0 0 0 0 world panda_link0" />

  <!-- MoveIt -->
  <include file="$(find panda_moveit_config)/launch/move_group.launch">
    <arg name="allow_trajectory_execution" value="true"/>
    <arg name="load_gripper" value="$(arg load_gripper)"/>
  </include>

  <!-- RViz -->
  <node pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find panda_moveit_config)/launch/moveit.rviz"/>

  <!-- Scan node -->
  <node pkg="panda_lung_scan_noetic"
        type="scan_moveit_real"
        name="scan_moveit_real"
        output="screen">
    <rosparam command="load" file="$(find panda_lung_scan_noetic)/config/lung_scan.yaml"/>
    <param name="contact_offset" value="-0.001"/>
  </node>
</launch>