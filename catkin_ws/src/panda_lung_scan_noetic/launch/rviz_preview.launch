<launch>
  <!-- Load Panda URDF into robot_description -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find franka_description)/robots/panda/panda.urdf.xacro' hand:=false"/>

  <!-- Publish robot state -->
  <node pkg="robot_state_publisher"
        type="robot_state_publisher"
        name="robot_state_publisher"/>

  <!-- Optional static joint state publisher for fixed preview -->
  <node pkg="joint_state_publisher"
        type="joint_state_publisher"
        name="joint_state_publisher"/>

  <!-- Your scan preview node -->
  <node pkg="panda_lung_scan_noetic"
        type="scan_preview"
        name="scan_preview"
        output="screen"/>

  <!-- RViz -->
  <node pkg="rviz"
        type="rviz"
        name="rviz"/>
</launch>